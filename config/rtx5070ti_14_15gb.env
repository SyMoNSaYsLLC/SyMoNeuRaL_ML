# SyMoNeuRaL RTX 5070 Ti 16GB VRAM permanent max profile.
# This is the canonical source of truth for local startup.
# Do not replace this with the old ~8GB conservative profile.

export SYMON_GPU_PROFILE="rtx5070ti_16gb_hard_lock_14_15gb"
export SYMON_EXCLUSIVE_VRAM="true"
export SYMON_RESIDENT_ENGINE="writer"

# Force adaptive profiles to keep this floor instead of dropping manager/writer
# back to 8192/16384 contexts.
export SYMON_FORCE_TEXT_MAX="1"
export SYMON_MIN_TEXT_CTX="294912"

# llama.cpp common flags.
export SYMON_LLAMA_GPU_LAYERS="999"
export SYMON_LLAMA_CTX="294912"
export SYMON_LLAMA_BATCH="4096"
export SYMON_LLAMA_UBATCH="512"
export SYMON_LLAMA_PARALLEL="2"
export SYMON_LLAMA_NP="2"

# Keep KV cache on high-quality f16. This is intentional for the 14-15GB target.
# Do not pass these as SYMON_LLAMA_EXTRA_ARGS. They are first-class flags now,
# so we never lose the value for --cache-type-v.
export SYMON_LLAMA_CACHE_TYPE_K="f16"
export SYMON_LLAMA_CACHE_TYPE_V="f16"
export LLAMA_ARG_CACHE_TYPE_K="f16"
export LLAMA_ARG_CACHE_TYPE_V="f16"
export SYMON_LLAMA_EXTRA_ARGS=""

# writer/chat/manager model.
export SYMON_CHAT_GPU_LAYERS="999"
export SYMON_CHAT_CTX="294912"
export SYMON_CHAT_BATCH="4096"
export SYMON_CHAT_UBATCH="512"
export SYMON_CHAT_PARALLEL="2"
export SYMON_CHAT_NP="2"

export SYMON_WRITER_GPU_LAYERS="999"
export SYMON_WRITER_CTX="294912"
export SYMON_WRITER_BATCH="4096"
export SYMON_WRITER_UBATCH="512"
export SYMON_WRITER_PARALLEL="2"
export SYMON_WRITER_NP="2"

# code model. Code can use the same large profile when handed the GPU.
export SYMON_CODE_GPU_LAYERS="999"
export SYMON_CODE_CTX="294912"
export SYMON_CODE_BATCH="4096"
export SYMON_CODE_UBATCH="512"
export SYMON_CODE_PARALLEL="1"
export SYMON_CODE_NP="1"

# stable-diffusion.cpp max practical 16GB-card image defaults.
export SYMON_IMAGE_WIDTH="1216"
export SYMON_IMAGE_HEIGHT="1216"
export SYMON_IMAGE_STEPS="40"
export SYMON_IMAGE_BATCH="1"
export SYMON_IMAGE_MAX_DIM="1216"
export SYMON_IMAGE_MAX_PIXELS="1478656"

# Target used by watch/bench docs. Total GPU memory includes KDE/desktop.
export SYMON_TARGET_VRAM_MIB="14500"
export SYMON_MIN_VRAM_MIB="14000"
export SYMON_MAX_VRAM_MIB="15360"

export SYMON_ENGINE_READY_TIMEOUT="480"
export SYMON_ENGINE_READY_POLL="0.5"
