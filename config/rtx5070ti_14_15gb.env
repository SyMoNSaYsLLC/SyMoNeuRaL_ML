# SyMoNeuRaL RTX 5070 Ti 16GB VRAM permanent max profile.
# Goal: keep normal llama-server runs around 14-15 GiB total GPU memory,
# instead of falling back to the old ~8 GiB conservative/default profile.

export SYMON_GPU_PROFILE="rtx5070ti_16gb_force_14_15gb"

# llama.cpp common flags
export SYMON_LLAMA_GPU_LAYERS="999"
export SYMON_LLAMA_PARALLEL="1"
export SYMON_LLAMA_CTX="65536"
export SYMON_LLAMA_BATCH="4096"
export SYMON_LLAMA_UBATCH="512"

# writer/chat/manager model
export SYMON_WRITER_GPU_LAYERS="999"
export SYMON_WRITER_PARALLEL="1"
export SYMON_WRITER_CTX="65536"
export SYMON_WRITER_BATCH="4096"
export SYMON_WRITER_UBATCH="512"

# code model; also high-context, but still single-parallel to avoid runaway OOM
export SYMON_CODE_GPU_LAYERS="999"
export SYMON_CODE_PARALLEL="1"
export SYMON_CODE_CTX="65536"
export SYMON_CODE_BATCH="4096"
export SYMON_CODE_UBATCH="512"

# stable-diffusion.cpp max practical 16GB-card image defaults
export SYMON_IMAGE_WIDTH="1152"
export SYMON_IMAGE_HEIGHT="1152"
export SYMON_IMAGE_STEPS="40"
export SYMON_IMAGE_BATCH="1"

# Target used by bench/watch scripts.
export SYMON_TARGET_VRAM_MIB="14500"
export SYMON_MIN_VRAM_MIB="14000"
export SYMON_MAX_VRAM_MIB="15360"

# Make llama.cpp server reject accidental multi-slot context splitting unless a script overrides it.
export LLAMA_ARG_PARALLEL="1"
